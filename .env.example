# Copie para .env (nunca envie .env para GitHub).
# Públicos: frontend
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_BUSINESS_NAME=Pequenos Heróis
VITE_SUPPORT_EMAIL=

# Privados: servidor / scripts locais; jamais prefixar com VITE_
