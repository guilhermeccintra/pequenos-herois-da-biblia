SUPABASE_SERVICE_ROLE_KEY=
APP_URL=https://SEU_DOMINIO.vercel.app
# Token recebido no campo "token" do postback Perfect Pay (não é o código do plano).
PERFECTPAY_WEBHOOK_TOKEN=

# Opcionais, somente para gerar narração com IA no computador do responsável
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
