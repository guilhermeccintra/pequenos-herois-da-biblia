{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": { "api/*.js": { "maxDuration": 60 } },
  "rewrites": [
    { "source": "/biblioteca", "destination": "/index.html" },
    { "source": "/historia/:id", "destination": "/index.html" },
    { "source": "/planos", "destination": "/index.html" },
    { "source": "/conta", "destination": "/index.html" },
    { "source": "/entrar", "destination": "/index.html" },
    { "source": "/cadastro", "destination": "/index.html" },
    { "source": "/recuperar", "destination": "/index.html" },
    { "source": "/definir-senha", "destination": "/index.html" },
    { "source": "/privacidade", "destination": "/index.html" },
    { "source": "/termos", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.supabase.co; font-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co; media-src 'self' https://*.supabase.co; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        }
      ]
    }
  ]
}
